    "FUNCTIONS_WORKER_RUNTIME": "python",
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "PRICE_SYNC_SCHEDULE": "0 0 18 * * *",
    "AZURE_SUBSCRIPTION_ID": "<サブスクリプション ID>",
    "APIM_RESOURCE_GROUP": "<APIM のリソースグループ名>",
    "APIM_NAME": "<APIM のサービス名>",
    "PRICE_NAMED_VALUE": "llm-price-table"
